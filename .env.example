# Configuration de la Base de Données (Production sur Vercel)
# --------------------------------------------------------
# Ces variables doivent être ajoutées dans l'onglet "Settings" > "Environment Variables" 
# de votre projet sur le tableau de bord Vercel.
#
# Si vous n'avez pas encore de base de données en ligne, vous pouvez en créer une 
# gratuitement sur des services comme Aiven (aiven.io) ou Clever Cloud (clever-cloud.com).

DB_HOST="votre_hote_serveur_distant.com"
DB_NAME="nom_de_la_base_de_donnees"
DB_USER="nom_d_utilisateur"
DB_PASS="votre_mot_de_passe_secret"
DB_CHARSET="utf8mb4"

# Indique à l'application qu'elle tourne sur Vercel
VERCEL="1"
